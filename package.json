{
  "name": "fastify-boilerplate",
  "version": "1.0.0",
  "description": "Boilerplate for Fastify API's with Zod (with zod type provider) and Prisma ORM",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --require tsconfig-paths/register src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node --require tsconfig-paths/register dist/index.js",
    "lint": "eslint --ext .ts src",
    "type-check": "tsc --noEmit",
    "prettier": "prettier --write \"src/**/*.{ts,tsx}\"",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy"
  },
  "keywords": [],
  "author": "Lucas Ferreira",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "^6.12.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.4.0",
    "fastify-type-provider-zod": "^4.0.2",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^22.16.5",
    "eslint": "^9.31.0",
    "eslint-plugin-unicorn": "^59.0.1",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prisma": "^6.12.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "_moduleAliases": {
    "@": "./dist"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad"
}